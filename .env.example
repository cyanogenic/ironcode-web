NODE_ENV=production
# HTTP listener on the Docker host (loopback only).
HTTP_PORT=8080
# NestJS listener inside the app container. Nginx uses port 80.
API_PORT=3000
CUSTOMER_HOST=ironcode.cn
APP_ORIGINS=https://ironcode.cn
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://ironcode:replace-with-a-long-random-password@postgres:5432/ironcode?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=true

CUSTOMER_PHONE_LOGIN_ENABLED=true
CUSTOMER_EMAIL_LOGIN_ENABLED=true

# Development prints the verification code to the API log. Production must use Aliyun SMS.
OTP_PROVIDER=aliyun
OTP_PEPPER=replace-with-at-least-32-random-characters
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com

# Development may print email codes to the API log. Production must use SMTP.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=铁码维修
SMTP_FROM_ADDRESS=

# Cloudflare R2 private bucket (S3-compatible API)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Used only by the explicit admin seed command.
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
